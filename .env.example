# ============================================
# Prometheus - Environment Variables
# ============================================

# --- Lit Protocol (Wallet) ---
LIT_API_KEY=
LIT_NETWORK=datil
# PKP public key (set after wallet creation via setup-wallet script)
LIT_PKP_PUBLIC_KEY=
LIT_PKP_TOKEN_ID=
LIT_PKP_ETH_ADDRESS=

# --- Base L2 (DeFi) ---
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453

# --- DBC Chain (GPU + DLP) ---
DBC_RPC_URL=https://info.dbcwallet.io
DBC_GPU_API_URL=https://dbchain.ai/api
DBC_CHAIN_ID=19880818

# --- BoxHire API (LLM inference via DLP) ---
BOXHIRE_API_URL=https://api.boxhire.work/api/v1/proxy/v1
BOXHIRE_API_KEY=
BOXHIRE_JWT=

# --- Social / Identity (provided by creator) ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
GITHUB_TOKEN=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=

# --- Safety ---
SAFETY_RESERVE_USD=15
MAX_SINGLE_ACTION_USD=10

# --- Creator ---
CREATOR_WALLET_ADDRESS=
